# Copy to .env and fill in. Empty file boots in dev mode with sane defaults.

ENVIRONMENT=dev
# Accept {"identity_token": "dev:anyone"} instead of a real Apple token. This
# is a full auth bypass — local development and tests only. Never set it on a
# deployed service; leaving it out is what keeps production safe.
ALLOW_DEV_SIGN_IN=true
DATABASE_URL=postgresql+psycopg2://reelmap:reelmap@localhost:5432/reelmap
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET=change-me-in-prod
APPLE_BUNDLE_ID=com.yourco.reelmap

# AI extraction (required for real analysis)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Reel fetching: apify (real reels) | stub (offline sample)
# One Apify token covers all platforms; actors are per-platform (override if you
# pick a different actor — field mapping may need a tweak in worker/fetchers/).
REEL_FETCHER=apify
APIFY_TOKEN=
# Reel fetching. "apify" runs the Apify actor and falls back to yt-dlp when it
# fails; "ytdlp" uses yt-dlp alone; "stub" is the offline sample.
# The two fail differently — a hosted service vs a local extractor — so one
# being down usually isn't an outage. Set FETCHER_FALLBACK=false to disable.
FETCHER_FALLBACK=true

APIFY_ACTOR=apify/instagram-scraper
APIFY_ACTOR_TIKTOK=clockworks/tiktok-scraper
APIFY_ACTOR_YOUTUBE=streamers/youtube-scraper

# What we're willing to pin. Reels that aren't recommendations of visitable
# venues (meal-kit ads, recipe videos, product promos) are rejected outright
# before geocoding. Beyond that, only these categories are kept — the extractor
# can also emit hotel, sight, event and club, excluded by default because this
# is a food-and-drink app. Add them here to widen it.
ALLOWED_PLACE_CATEGORIES=cafe,restaurant,bar

# Ops view. Guards GET /admin/stats — users, reels, places and cost, as JSON.
# Unset means the endpoint 404s, which is the right default. Generate one with
# `openssl rand -hex 32`.
ADMIN_TOKEN=

# Geocoding: nominatim (free OpenStreetMap, default) | google (adds ratings,
# reviews, photos, hours, phone + candidate scoring for correct branch/venue).
# For google: enable "Places API (New)" in Google Cloud and paste the key below.
GEOCODER=nominatim
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_REGION=US
GOOGLE_PLACES_LANGUAGE=en

# Transcription
ENABLE_TRANSCRIPTION=true
WHISPER_MODEL=small

# Push (APNs) — optional in dev.
# Local dev: point APNS_KEY_PATH at the .p8 file.
# Railway/Fly: secrets are env vars, not files — base64 the .p8 into
# APNS_KEY_CONTENT instead (`base64 -i AuthKey_XXX.p8`).
APNS_KEY_PATH=
APNS_KEY_CONTENT=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=com.yourco.reelmap
APNS_USE_SANDBOX=true

# Abuse protection. A public URL is a direct line to the Anthropic/Google bill.
RATE_LIMIT_REELS_PER_HOUR=20
RATE_LIMIT_AUTH_PER_HOUR=30

# Free-tier cap. A reel with 5 places costs ~$0.27 (Google Places dominates),
# so this is a direct monthly liability per free user.
FREE_MONTHLY_REEL_LIMIT=50
