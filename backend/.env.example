# Copy to .env and fill in. Empty file boots in dev mode with sane defaults.

ENVIRONMENT=dev
DATABASE_URL=postgresql+psycopg2://reelmap:reelmap@localhost:5432/reelmap
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET=change-me-in-prod
APPLE_BUNDLE_ID=com.yourco.reelmap

# AI extraction (required for real analysis)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Reel fetching: apify (real reels) | stub (offline sample)
# One Apify token covers all platforms; actors are per-platform (override if you
# pick a different actor — field mapping may need a tweak in worker/fetchers/).
REEL_FETCHER=apify
APIFY_TOKEN=
APIFY_ACTOR=apify/instagram-scraper
APIFY_ACTOR_TIKTOK=clockworks/tiktok-scraper
APIFY_ACTOR_YOUTUBE=streamers/youtube-scraper

# Geocoding: nominatim (free OpenStreetMap, default) | google (adds photos/ratings)
GEOCODER=nominatim
GOOGLE_PLACES_API_KEY=

# Transcription
ENABLE_TRANSCRIPTION=true
WHISPER_MODEL=small

# Push (APNs) — optional in dev
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=com.yourco.reelmap
APNS_USE_SANDBOX=true
