# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Env / secrets
.env
*.p8

# Data
*.sqlite3
pgdata/

# iOS / Xcode
# The project is generated from project.yml by XcodeGen — never commit it.
*.xcodeproj/
ios/**/build/
ios/**/DerivedData/
*.xcuserstate
.DS_Store

# Generated by XcodeGen from ios/project.yml, which is the source of truth for
# these — see its `info:` and `entitlements:` blocks. Committing them means a
# stale copy silently disagreeing with the spec that regenerates it.
ios/ReelMap/Info.plist
ios/ReelMap/ReelMap.entitlements
ios/ShareExtension/Info.plist
ios/ShareExtension/ShareExtension.entitlements

# Stray editor / REPL history
.Rhistory

# Editors
.idea/
.vscode/
