---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  /** Suppresses the site chrome on pages that supply their own. */
  bare?: boolean;
}

const { title, description, bare = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Downscaled from the app icon, so a browser tab and the phone home
         screen show the same mark. -->
    <link rel="icon" href="/favicon.png" type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Display face only. Body type is the system stack, which resolves to
         SF Pro on the iPhones this site is selling to — the same face the app
         uses, at no download cost. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&display=swap"
    />
  </head>
  <body>
    {!bare && <Header />}
    <main id="main">
      <slot />
    </main>
    {!bare && <Footer />}

    <script>
      // Scroll reveal. ~20 lines of IntersectionObserver rather than a
      // 40kB animation library; siblings stagger so a row of items arrives
      // as a sequence instead of a block.
      const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (reduced || !('IntersectionObserver' in window)) {
        items.forEach((el) => el.classList.add('is-in'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              const el = entry.target as HTMLElement;
              const group = el.parentElement?.querySelectorAll('[data-reveal]');
              const index = group ? Array.from(group).indexOf(el) : 0;
              el.style.setProperty('--reveal-delay', `${Math.min(index, 5) * 60}ms`);
              el.classList.add('is-in');
              io.unobserve(el);
            });
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.1 },
        );
        items.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
